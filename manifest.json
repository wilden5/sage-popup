{
  "manifest_version": 3,
  "name": "Oxford Popup",
  "version": "1.1.2",
  "description": "Select a word, click the floating button, and see its Oxford Learner's Dictionary definition in a minimal popup. Phrases and missing words are explained by Mistral AI.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.oxfordlearnersdictionaries.com/*"
  ],
  "optional_host_permissions": [
    "https://api.mistral.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "oxford-popup@denis",
      "strict_min_version": "121.0"
    }
  }
}
