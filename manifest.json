{
  "manifest_version": 3,
  "name": "Sage Pop-Up",
  "version": "1.3.0",
  "description": "Select a word or phrase and get a minimal popup: an Oxford Learner's Dictionary definition, or an AI explanation with your own key.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.oxfordlearnersdictionaries.com/*"
  ],
  "optional_host_permissions": [
    "https://api.mistral.ai/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*",
    "https://openrouter.ai/*",
    "https://api.deepseek.com/*",
    "https://api.x.ai/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "sage@wilden5",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["websiteContent"],
        "optional": ["authenticationInfo"]
      }
    }
  }
}
